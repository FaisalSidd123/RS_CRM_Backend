PORT=5000
FRONTEND_URL=http://localhost:5173

# Meta WhatsApp Business Cloud API Configuration
# Step 1: Set this exact token in Meta App Dashboard > WhatsApp > Configuration > Verify Token
META_VERIFY_TOKEN=propertyos_pakistan_verify_2026

# Step 2: System User Access Token with 'whatsapp_business_messaging' and 'whatsapp_business_management' permissions
META_ACCESS_TOKEN=your_meta_system_user_access_token_here

# Step 3: Phone Number ID from WhatsApp > API Setup
META_PHONE_NUMBER_ID=your_phone_number_id_here

# Step 4: WhatsApp Business Account ID (WABA ID)
META_WABA_ID=your_waba_account_id_here
